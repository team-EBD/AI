# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# 최신 flash 모델 사용. .env로 교체 가능하며, 이 값이 ai_call_log.model_name 으로 그대로 반영됨.
GEMINI_MODEL=gemini-2.5-flash

# AI 호출 timeout (초). 명세서 기준 15초.
AI_TIMEOUT_SECONDS=15

# 이미지 다운로드 timeout (초).
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=10

# 이미지 다운로드 최대 허용 크기(bytes). 기본 10MB. 초과 시 provider_error 로 실패.
MAX_IMAGE_BYTES=10485760

# 내부 호출 인증 토큰(opt-in, SCRUM-28).
# 비워두면 검증하지 않음. 값을 설정하면 BE 가 X-Internal-Token 헤더로 동일 값을 보내야 함.
INTERNAL_TOKEN=

# recommend 후보 조회용 DB(읽기 전용). BE 와 동일한 Postgres.
# 미설정 시 recommend 는 provider_error 로 실패한다.
DATABASE_URL=postgresql+psycopg://eatlog:eatlog@localhost:5432/eatlog

# Gemini 2.5 thinking 토큰 예산 (0=비활성, 기본). 켜면 호출당 지연이 크게 늘어난다.
GEMINI_THINKING_BUDGET=0

# 디코딩 고정 — 같은 사진에 같은 결과가 나오도록 한다 (기본값 권장)
GEMINI_TEMPERATURE=0
GEMINI_SEED=20260722
