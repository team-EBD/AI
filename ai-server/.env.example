# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# 최신 flash 모델 사용. .env로 교체 가능하며, 이 값이 ai_call_log.model_name 으로 그대로 반영됨.
GEMINI_MODEL=gemini-2.5-flash

# AI 호출 timeout (초). 명세서 기준 15초.
AI_TIMEOUT_SECONDS=15

# 이미지 다운로드 timeout (초).
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=10

# 내부 호출 인증 토큰(opt-in, SCRUM-28).
# 비워두면 검증하지 않음. 값을 설정하면 BE 가 X-Internal-Token 헤더로 동일 값을 보내야 함.
INTERNAL_TOKEN=

# recommend 후보 조회용 DB(읽기 전용). BE 와 동일한 Postgres.
# 미설정 시 recommend 는 provider_error 로 실패한다.
DATABASE_URL=postgresql+psycopg://eatlog:eatlog@localhost:5432/eatlog
